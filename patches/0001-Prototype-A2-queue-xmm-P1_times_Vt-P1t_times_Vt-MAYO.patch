+        target_compile_definitions(${MVARIANT_LOWER}_tailab PUBLIC MAYO_VARIANT=${MVARIANT} MAYO_TAIL_XMM MAYO_TAIL_AB)
+        # -DMAYO_TAIL_CHECK=ON : verifie la precondition des multabs a l'execution (abort sinon)
