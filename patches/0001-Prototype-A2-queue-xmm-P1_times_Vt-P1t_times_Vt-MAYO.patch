+#!/usr/bin/env python3
+"""Boucle interne (celle qui contient les vpshufb) de chaque noyau : decompte des instructions par classe.
+Usage : loop_stats.py <executable> <fonction>..."""
+import re, subprocess, sys, collections
+exe = sys.argv[1]
+dis = subprocess.run(["objdump", "-d", "--no-show-raw-insn", "-M", "att", exe], capture_output=True, text=True).stdout
+def cls(l):
+    op = l.split()[0]
+    if op.startswith("vpshufb"): return "vpshufb"
+    if re.search(r"\(%rsp\)|\(%rbp\)", l):
+        return "spill/reload (pile) " + ("store" if re.search(r",\s*[-0-9a-fx]*\(%r[sb]p\)$", l) else "load")
+    if re.match(r"v?pxor|vpor|vxorps|xor", op): return "xor"
+    if re.match(r"vpand|and", op): return "and"
+    if re.match(r"vpsrl|vpsll", op): return "shift"
+    if re.match(r"vpunpck|vpalign|vperm|vpblend|vinsert|vextract|vpbroad", op): return "permute/unpack"
+    if re.match(r"vmov|mov", op): return "mov (autres)"
+    if re.match(r"add|lea|inc|sub|cmp|test|j", op): return "controle/adresse"
+    return "autres"
+for fn in sys.argv[2:]:
+    m = re.search(r"^[0-9a-f]+ <%s>:\n(.*?)\n\n" % re.escape(fn), dis, re.S | re.M)
+    if not m: print(fn, "introuvable"); continue
+    rows = []
+    for l in m.group(1).split("\n"):
+        mm = re.match(r"\s*([0-9a-f]+):\s*(.*)$", l)
+        if mm: rows.append((int(mm.group(1), 16), re.sub(r"\s+#.*$", "", mm.group(2)).strip()))
+    # boucles : jcc/jmp arriere
+    best = None
+    for i, (a, l) in enumerate(rows):
+        mj = re.match(r"j[a-z]+\s+([0-9a-f]+)", l)
+        if mj and int(mj.group(1), 16) < a:
+            t = int(mj.group(1), 16)
+            body = [r for r in rows if t <= r[0] <= a]
+            nsh = sum(1 for r in body if r[1].startswith("vpshufb"))
+            if nsh and (best is None or len(body) < len(best)): best = body
+    if best is None: print(fn, ": pas de boucle"); continue
+    c = collections.Counter(cls(r[1]) for r in best)
+    print(f"=== {fn} : boucle interne = {len(best)} instructions (vpshufb : {c['vpshufb']})")
+    for k, v in sorted(c.items(), key=lambda x: -x[1]): print(f"    {k:28s} {v}")
