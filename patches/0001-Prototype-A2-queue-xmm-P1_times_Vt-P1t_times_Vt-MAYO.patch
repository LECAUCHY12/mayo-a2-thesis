+
+/* ------------------------------------------------------------------------------------
+   Variante "queue xmm" (experimentale, -DMAYO_TAIL_XMM ; MAYO-1 (m=80) et MAYO-5 (m=142)
+   seulement ; specialisation de P1_times_Vt / P1t_times_Vt UNIQUEMENT : la macro
+   MULTIPLY_ACCUMULATE_M_VEC et tous les autres chemins restent inchanges).
+
+   Disposition de P1 en memoire (PINV) : P1 reste dans la disposition EMPAQUETEE du flux de cle,
+   M_MAX/2 octets par m-vec (40 octets pour m=80, 71 pour m=142), sans bourrage entre entrees.
+   Les M_MAX/2 octets sont suivis, dans le meme tableau sk->p (P1_LIMBS_MAX + P2_LIMBS_MAX +
+   MAYO_MVEC_SLACK limbes), de la suite du tampon : P1 occupe NENT*(M_MAX/2) octets et la zone
+   reservee a P1 en occupe 8*P1_LIMBS_MAX (720 863 contre 731 016 octets pour MAYO-5) ; l'octet
+   qui suit P1 empaquete est le premier octet du flux de cle de P2 (ecrit par AES-128-CTR, donnee
+   publique) que unpack_m_vecs n'ecrase jamais (il ecrit a partir de l'octet 8*P1_LIMBS_MAX).
+
+   Un m-vec = M_MAX/2 octets. Les 32*MTX_NM premiers octets sont traites comme avant par
+   MTX_NM registres ymm SANS recouvrement (aucun chargement recouvrant). Les 8 octets
+   suivants (la queue, 16 nibbles : 16 utiles pour m=80, 14 utiles + 2 de bourrage pour
+   m=142) sont lus par un chargement de 8 octets, mis sous la forme
+   [nibbles bas (8 octets) | nibbles hauts (8 octets)] dans un xmm, multiplies par un
+   vpshufb xmm avec la moitie basse du multab deja charge, et accumules dans un xmm.
+
+   Etendue de lecture par entree : [0, 32*MTX_NM+8) = 40 octets (m=80, egale a l'entree) et
+   72 octets (m=142, soit 1 octet de plus que l'entree de 71 octets). Le noyau officiel lit la
+   meme etendue (dernier chargement ymm a M_VEC_LIMBS_MAX-4 limbes = octets 40..71). Pour m=142 :
+   - pour toute entree sauf la derniere, l'octet 71 est le premier octet de l'entree suivante ;
+   - pour la derniere entree de P1, il tombe sur l'octet NENT*71 du tableau sk->p (flux de cle de
+     P2, cf. ci-dessus), toujours alloue : voir les _Static_assert ci-dessous ;
+   - cet octet n'alimente que les nibbles de bourrage 142 et 143 (octet 7 du limbe 8 de
+     l'accumulateur), jamais un des m = 142 elements utiles (vpshufb, decalages et XOR operent
+     nibble par nibble).
+   Variante MAYO_TAIL_XMM_SAFE : la queue est lue aux octets [63, 71) puis decalee de 8 bits ;
+   aucune lecture au-dela de l'entree (une instruction de plus par entree) ; l'octet de bourrage
+   de l'accumulateur vaut alors 0 au lieu d'une donnee voisine. */
+#if defined(MAYO_TAIL_XMM) && !defined(ENABLE_PARAMS_DYNAMIC) && (M_MAX == 80 || M_MAX == 142)
+#define MAYO_TAIL_XMM_ACTIVE 1
+#define MTX_KP ((K_MAX + 1) / 2)
+#define MTX_NM (M_MAX / 64)                 /* registres ymm pleins : 1 (m=80), 2 (m=142) */
+#define MTX_TOFF (32 * MTX_NM)              /* octet de debut de la queue */
+#define MTX_TLIMB (4 * MTX_NM)              /* limbe de debut de la queue dans l'accumulateur */
+#define MTX_NENT ((size_t) V_MAX * (V_MAX + 1) / 2)
+#if defined(MAYO_TAIL_XMM_SAFE) && (M_MAX / 2 < MTX_TOFF + 8)
+#define MTX_SAFE_ACTIVE 1
+#define MTX_OVERREAD 0                      /* octets lus apres l'entree */
+#else
+#define MTX_OVERREAD (MTX_TOFF + 8 > M_MAX / 2 ? MTX_TOFF + 8 - M_MAX / 2 : 0)
+#endif
+/* Garanties d'acces (verifiees a la compilation) : la derniere lecture de queue se termine a
+   (NENT-1)*(M_MAX/2) + M_MAX/2 + MTX_OVERREAD octets du debut de P1 ; elle doit rester dans la zone
+   reservee a P1 (8*P1_LIMBS_MAX octets), elle-meme incluse dans sk->p / pk->p. */
+_Static_assert(MTX_NENT * (M_MAX / 2) + MTX_OVERREAD <= 8 * (size_t) P1_LIMBS_MAX,
+               "queue xmm : la derniere lecture sort de la zone reservee a P1");
+_Static_assert(M_MAX / 2 <= MTX_TOFF + 8, "queue xmm : la queue de 8 octets doit couvrir la fin de l'entree");
+_Static_assert(MTX_OVERREAD <= 1, "queue xmm : au plus 1 octet lu au-dela de l'entree");
+
+#ifdef MAYO_TAIL_XMM_CHECK
+/* Mode de verification (jamais en production) : la precondition "les deux voies de 128 bits de
+   chaque multab sont identiques" est testee sur les tables REELLEMENT passees aux noyaux ; abort()
+   sinon. Le compte des tables verifiees est affiche en fin de programme. */
+#include <stdlib.h>
+#include <stdio.h>
+static unsigned long long mtx_checked = 0;
+__attribute__((destructor)) static void mtx_report(void) {
+    if (mtx_checked) fprintf(stderr, "[MAYO_TAIL_XMM_CHECK] M_MAX=%d : %llu multabs verifiees, voies de 128 bits identiques\n", M_MAX, mtx_checked);
+}
+static inline void mtx_check_multabs(const __m256i *mt) {
+    for (size_t i = 0; i < (size_t) MTX_KP * V_MAX; i++) {
+        const __m256i d = _mm256_xor_si256(mt[i], _mm256_permute2x128_si256(mt[i], mt[i], 1));
+        if (!_mm256_testz_si256(d, d)) { fprintf(stderr, "multab %zu : voies de 128 bits differentes\n", i); abort(); }
+    }
+    mtx_checked += (unsigned long long) MTX_KP * V_MAX;
+}
+#define MTX_CHECK(mt) mtx_check_multabs(mt)
+#else
+#define MTX_CHECK(mt) ((void) 0)
+#endif
+
+static inline __m128i mtx_tail_prep(const uint8_t *e) {
+    const __m128i m = _mm_set1_epi8(0x0f);
+#if defined(MTX_SAFE_ACTIVE)
+    __m128i x  = _mm_srli_epi64(_mm_loadl_epi64((const __m128i *) (e + MTX_TOFF - 1)), 8);
+#else
+    __m128i x  = _mm_loadl_epi64((const __m128i *) (e + MTX_TOFF));
+#endif
+    __m128i xh = _mm_srli_epi16(x, 4);
+    return _mm_and_si128(_mm_unpacklo_epi64(x, xh), m);
+}
+
+#define MTX_STEP(vec, mt_base, tt)                                                             \
+    {                                                                                          \
+        __m256i in_o[MTX_NM], in_e[MTX_NM];                                                    \
+        for (int g = 0; g < MTX_NM; g++) {                                                     \
+            in_o[g] = _mm256_loadu_si256((const __m256i *) ((vec) + 4 * g));                   \
+            in_e[g] = _mm256_and_si256(_mm256_srli_epi16(in_o[g], 4), low_nibble_mask);        \
+            in_o[g] = _mm256_and_si256(in_o[g], low_nibble_mask);                              \
+        }                                                                                      \
+        const __m128i tl = mtx_tail_prep((const uint8_t *) (vec));                             \
+        for (int p = 0; p < MTX_KP; p++) {                                                     \
+            const __m256i mt = (mt_base)[p];                                                   \
+            for (int g = 0; g < MTX_NM; g++) {                                                 \
+                temp[(p * MTX_NM + g) * 2]     ^= _mm256_shuffle_epi8(mt, in_o[g]);            \
+                temp[(p * MTX_NM + g) * 2 + 1] ^= _mm256_shuffle_epi8(mt, in_e[g]);            \
+            }                                                                                  \
+            (tt)[p] = _mm_xor_si128((tt)[p], _mm_shuffle_epi8(_mm256_castsi256_si128(mt), tl));\
+        }                                                                                      \
+    }
+
+/* reassemblage : meme formule que DISENTANGLE_AND_ACCUMULATE_M_VECS, sans recouvrement ;
+   les chargements de acc precedent tous les stockages d'une paire de sorties */
+static inline void mtx_disentangle(const __m256i *temp, const __m128i *tt, uint64_t *ar, const __m256i low_nibble_mask) {
+    const __m128i m128 = _mm_set1_epi8(0x0f);
+    for (int p = 0; p < MTX_KP; p++) {
+        const int k = 2 * p;
+        for (int g = 0; g < MTX_NM; g++) {
+            const __m256i o = temp[(p * MTX_NM + g) * 2], e = temp[(p * MTX_NM + g) * 2 + 1];
+            const __m256i t = _mm256_and_si256(_mm256_xor_si256(e, _mm256_srli_epi16(o, 4)), low_nibble_mask);
+            uint64_t *a0 = ar + (size_t) k * M_VEC_LIMBS_MAX + 4 * g;
+            _mm256_storeu_si256((__m256i *) a0, _mm256_xor_si256(_mm256_loadu_si256((__m256i *) a0),
+                                _mm256_xor_si256(o, _mm256_slli_epi16(t, 4))));
+            if (k + 1 < K_MAX) {
+                uint64_t *a1 = ar + (size_t) (k + 1) * M_VEC_LIMBS_MAX + 4 * g;
+                _mm256_storeu_si256((__m256i *) a1, _mm256_xor_si256(_mm256_loadu_si256((__m256i *) a1),
+                                    _mm256_xor_si256(e, t)));
+            }
+        }
+        {   /* queue : [impairs | pairs] */
+            const __m128i o = tt[p];
+            const __m128i e = _mm_unpackhi_epi64(o, o);
+            const __m128i t = _mm_and_si128(_mm_xor_si128(e, _mm_srli_epi16(o, 4)), m128);
+            ar[(size_t) k * M_VEC_LIMBS_MAX + MTX_TLIMB] ^= (uint64_t) _mm_cvtsi128_si64(_mm_xor_si128(o, _mm_slli_epi16(t, 4)));
+            if (k + 1 < K_MAX)
+                ar[(size_t) (k + 1) * M_VEC_LIMBS_MAX + MTX_TLIMB] ^= (uint64_t) _mm_cvtsi128_si64(_mm_xor_si128(e, t));
+        }
+    }
+}
+
+static
+inline void P1_times_Vt_xmm(const uint64_t *P1, __m256i *V_multabs, uint64_t *acc){
+    MTX_CHECK(V_multabs);
+    const __m256i low_nibble_mask = _mm256_set1_epi8(0x0f);
+    size_t cols_used = 0;
+    for (size_t r = 0; r < V_MAX; r++)
+    {
+        __m256i temp[MTX_KP * 2 * MTX_NM];
+        __m128i tt[MTX_KP];
+        for (int i = 0; i < MTX_KP * 2 * MTX_NM; i++) temp[i] = _mm256_setzero_si256();
+        for (int i = 0; i < MTX_KP; i++) tt[i] = _mm_setzero_si128();
+        for (size_t c = r; c < V_MAX; c++)
+        {
+            const uint64_t *v = PINV(P1, cols_used);
+            MTX_STEP(v, V_multabs + MTX_KP * c, tt)
+            cols_used += 1;
+        }
+        mtx_disentangle(temp, tt, acc + r * K_MAX * M_VEC_LIMBS_MAX, low_nibble_mask);
+    }
+}
+
+static
+inline void P1t_times_Vt_xmm(const uint64_t *P1, __m256i *V_multabs, uint64_t *acc){
+    MTX_CHECK(V_multabs);
+    const __m256i low_nibble_mask = _mm256_set1_epi8(0x0f);
+    __m256i temp[MTX_KP * 2 * MTX_NM];
+    __m128i tt[MTX_KP];
+    size_t row_start = 0;
+    for (size_t r = 0; r < V_MAX; r++)
+    {
+        for (int i = 0; i < MTX_KP * 2 * MTX_NM; i++) temp[i] = _mm256_setzero_si256();
+        for (int i = 0; i < MTX_KP; i++) tt[i] = _mm_setzero_si128();
+        size_t pos = r;
+        for (size_t c = 0; c < r; c++)
+        {
+            const uint64_t *v = PINV(P1, pos);
+            MTX_STEP(v, V_multabs + MTX_KP * c, tt)
+            pos += (V_MAX - c - 1);
+        }
+        {
+            const uint64_t *v = PINV(P1, row_start);
+            MTX_STEP(v, V_multabs + MTX_KP * r, tt)
+        }
+        mtx_disentangle(temp, tt, acc + r * K_MAX * M_VEC_LIMBS_MAX, low_nibble_mask);
+        row_start += (V_MAX - r);
+    }
+    /* comme P1t_times_Vt officiel : les produits (derives de V, secret) sont effaces */
+    mayo_secure_clear(temp, sizeof(temp));
+    mayo_secure_clear(tt, sizeof(tt));
+}
+#endif
+
 // P1*S1 -> P1: v x v, S1: v x k // P1 upper triangular
 static
 inline void S1t_times_PS1(const uint64_t *_PS1, __m256i *S1_multabs, uint64_t *_acc){
