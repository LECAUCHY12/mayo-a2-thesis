+/* Aiguillage des deux noyaux specialises "queue xmm" (experimental, MAYO_TAIL_XMM ;
+   actifs seulement pour m = 80 et m = 142 sur le moteur shuffle AVX2). Par defaut :
+   noyaux officiels, inchanges. MAYO_TAIL_AB : choix a l'execution (banc A/B). */
+#if defined(MAYO_TAIL_XMM_ACTIVE)
+#if defined(MAYO_TAIL_AB)
+extern int mayo_tail_use_xmm;
+#define MAYO_CALL_P1_VT(P1, M, ACC)  do { if (mayo_tail_use_xmm) P1_times_Vt_xmm(P1, M, ACC);  else P1_times_Vt(P1, M, ACC);  } while (0)
+#define MAYO_CALL_P1T_VT(P1, M, ACC) do { if (mayo_tail_use_xmm) P1t_times_Vt_xmm(P1, M, ACC); else P1t_times_Vt(P1, M, ACC); } while (0)
+#else
+#define MAYO_CALL_P1_VT(P1, M, ACC)  P1_times_Vt_xmm(P1, M, ACC)
+#define MAYO_CALL_P1T_VT(P1, M, ACC) P1t_times_Vt_xmm(P1, M, ACC)
+#endif
+#else
+#define MAYO_CALL_P1_VT(P1, M, ACC)  P1_times_Vt(P1, M, ACC)
+#define MAYO_CALL_P1T_VT(P1, M, ACC) P1t_times_Vt(P1, M, ACC)
+#endif
+
 /* One attempt's M into Mtmp and all v_i P v_j into VPV, with lambda folded in:
    Lambda(v_i) reaches column 0 of VPV through VKtmp, and block 0 of Mtmp picks
    up O^t lambda_vin + lambda_oil. */
@@ -273,7 +290,7 @@ static inline void m_calculate_M_and_VPV(const mayo_params_t *p,
     mayo_V_multabs(Vdec, V_multabs);
 
     MAYO_ACC_INIT(VKtmp); // P1_times_Vt accumulates into it
-    P1_times_Vt(P1, V_multabs, VKtmp);
+    MAYO_CALL_P1_VT(P1, V_multabs, VKtmp);
 
     /* lambda into column 0 of P1 * V^t. Vt_times_Pv runs on both paths, so
        Lambda(v_i) reaches VPV[i][0] for free either way. With L implicit,
@@ -299,7 +316,7 @@ static inline void m_calculate_M_and_VPV(const mayo_params_t *p,
         // implicit L: Mtmp = V * ((P1 + P1^t) * O + P2), reusing P1 * V^t.
         // VKtmp = (P1 + P1^t) * V^t; the diagonal cancels in characteristic two.
         mayo_O_multabs(O, O_multabs);
-        P1t_times_Vt(P1, V_multabs, VKtmp);
+        MAYO_CALL_P1T_VT(P1, V_multabs, VKtmp);
         Ut_times_O(VKtmp, O_multabs, Mtmp);
         Vt_times_L(P2_or_L, V_multabs, Mtmp);
     }
