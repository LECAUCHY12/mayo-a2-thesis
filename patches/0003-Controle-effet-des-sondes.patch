 #include <mayo.h>
 #include <arithmetic.h>
 #include <randombytes.h>
+#ifdef MAYO_PROFILING_PROBES
 #include <profiling_probes.h>
+#else
+/* build "plain" : meme programme de test, bibliotheque *_tailab SANS aucune sonde (seul le temps total est enregistre) */
