             target_compile_definitions(${MVARIANT_LOWER}_tailxmm PUBLIC MAYO_TAIL_XMM_SAFE)
             target_compile_definitions(${MVARIANT_LOWER}_tailab PUBLIC MAYO_TAIL_XMM_SAFE)
         endif()
+        # Decomposition instrumentee de mayo_sign (A/B apparie) : sondes MAYO_PROFILING_PROBES + choix a l'execution
+        add_library(${MVARIANT_LOWER}_phases ${SOURCE_FILES_MAYO} profiling_probes.c)
+        target_link_libraries(${MVARIANT_LOWER}_phases PUBLIC mayo_common_test)
