 src/profiling_probes.h              | 17 ++++++--
 test/CMakeLists.txt                 | 14 +++++++
 test/run_controle.sh                | 62 +++++++++++++++++++++++++++++
 test/sign_phases_ab.c               | 11 +++--
 test/tail_study/controle_analyze.py | 23 +++++++++++
 6 files changed, 141 insertions(+), 7 deletions(-)
 create mode 100644 test/run_controle.sh
 create mode 100644 test/tail_study/controle_analyze.py

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index f09c8d3..0d3cbbb 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -125,6 +125,27 @@ else()
         if (MAYO_TAIL_SAFE)
             target_compile_definitions(${MVARIANT_LOWER}_phases PUBLIC MAYO_TAIL_XMM_SAFE)
         endif()
+        # Controle "sondes eparses" : memes sources, seules certaines sondes sont actives (masque de compilation).
+        #   none : aucune sonde (code objet identique a _tailab) ; esk : expand_sk_internal seul ; mcalc : m_calculate_M_and_VPV seul
+        foreach(PTAG none esk mcalc)
+            if (PTAG STREQUAL "none")
+                set(PMASK 0x0ULL)
+            elseif (PTAG STREQUAL "esk")
+                set(PMASK 0x800ULL)
+            else()
+                set(PMASK 0x40ULL)
+            endif()
+            add_library(${MVARIANT_LOWER}_phases_${PTAG} ${SOURCE_FILES_MAYO} profiling_probes.c)
+            target_link_libraries(${MVARIANT_LOWER}_phases_${PTAG} PUBLIC mayo_common_test)
+            target_include_directories(${MVARIANT_LOWER}_phases_${PTAG} PUBLIC ../include . PRIVATE common ${INC_PLATFORM})
+            target_compile_definitions(${MVARIANT_LOWER}_phases_${PTAG} PUBLIC MAYO_VARIANT=${MVARIANT} MAYO_TAIL_XMM MAYO_TAIL_AB MAYO_PROFILING_PROBES MAYO_PROBES_MASK=${PMASK})
+            if (MAYO_TAIL_CHECK)
+                target_compile_definitions(${MVARIANT_LOWER}_phases_${PTAG} PUBLIC MAYO_TAIL_XMM_CHECK)
+            endif()
+            if (MAYO_TAIL_SAFE)
+                target_compile_definitions(${MVARIANT_LOWER}_phases_${PTAG} PUBLIC MAYO_TAIL_XMM_SAFE)
+            endif()
+        endforeach()
     ENDFOREACH()
 
     foreach(MVARIANT ${MVARIANT_S})
diff --git a/src/profiling_probes.h b/src/profiling_probes.h
index 6a269ad..f509d1e 100644
--- a/src/profiling_probes.h
+++ b/src/profiling_probes.h
@@ -112,11 +112,20 @@ static inline uint64_t probe_rdtscp(void) {
     return __rdtscp(&aux);
 }
 
-#define PROBE_START_ID(id) (probe_t0[(id)] = probe_rdtscp())
+// MAYO_PROBES_MASK : masque (bit = identifiant de sonde) des sondes ACTIVES, constante de compilation.
+// Par defaut toutes ; les sondes hors masque disparaissent a la compilation (aucune instruction).
+// Sert au controle "sondes eparses" (quelles frontieres de mesure modifient le comportement).
+#ifndef MAYO_PROBES_MASK
+#define MAYO_PROBES_MASK (~0ULL)
+#endif
+#define PROBE_ON(id) ((((unsigned long long) (MAYO_PROBES_MASK)) >> (id)) & 1ULL)
+#define PROBE_START_ID(id) do { if (PROBE_ON(id)) probe_t0[(id)] = probe_rdtscp(); } while (0)
 #define PROBE_END_ID(id) do { \
-        _mm_lfence(); \
-        probe_cycles[(id)] += probe_rdtscp() - probe_t0[(id)]; \
-        probe_calls[(id)] += 1; \
+        if (PROBE_ON(id)) { \
+            _mm_lfence(); \
+            probe_cycles[(id)] += probe_rdtscp() - probe_t0[(id)]; \
+            probe_calls[(id)] += 1; \
+        } \
     } while (0)
 // Alias historiques : la forme a un seul argument n'est plus utilisable des
 // deux cotes avec un etat partage (voir ci-dessus). PROBE_START() seul ne
