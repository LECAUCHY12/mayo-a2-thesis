diff --git a/src/arithmetic.h b/src/arithmetic.h
index 29795e1..8d749cd 100644
--- a/src/arithmetic.h
+++ b/src/arithmetic.h
@@ -7,6 +7,7 @@
 #include <stdint.h>
 #include <mayo.h>
 #include <stddef.h>
+#include <profiling_probes.h>
 
 #if defined(__BYTE_ORDER__) && (__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__)
 #ifndef TARGET_BIG_ENDIAN
@@ -186,6 +187,7 @@ void m_upper(const mayo_params_t* p, const uint64_t *in, uint64_t *out, int size
 #define sample_solution MAYO_NAMESPACE(sample_solution)
 int sample_solution(const mayo_params_t *p, unsigned char *A, const unsigned char *y, const unsigned char *r, unsigned char *x, int k, int o, int m, int A_cols);
 
+
 #if defined(__GNUC__) || defined(__clang__)
 #define BSWAP32(i) __builtin_bswap32((i))
 #define BSWAP64(i) __builtin_bswap64((i))
@@ -287,10 +289,14 @@ static inline void m_calculate_M_and_VPV(const mayo_params_t *p,
     mayo_multab_t O_multabs[MAYO_O_MULTABS_N];
     alignas(MAYO_MULTAB_ALIGN) mayo_multab_t V_multabs[MAYO_V_MULTABS_N];
 
+    PROBE_START_ID(PROBE_MCM_V_MULTABS);
     mayo_V_multabs(Vdec, V_multabs);
+    PROBE_END_ID(PROBE_MCM_V_MULTABS);
 
     MAYO_ACC_INIT(VKtmp); // P1_times_Vt accumulates into it
+    PROBE_START_ID(PROBE_MCM_P1_VT);
     MAYO_CALL_P1_VT(P1, V_multabs, VKtmp);
+    PROBE_END_ID(PROBE_MCM_P1_VT);
 
     /* lambda into column 0 of P1 * V^t. Vt_times_Pv runs on both paths, so
        Lambda(v_i) reaches VPV[i][0] for free either way. With L implicit,
@@ -298,9 +304,13 @@ static inline void m_calculate_M_and_VPV(const mayo_params_t *p,
        column 0 into (O^t lambda)[c] in block 0 of Mtmp; with L materialized
        there is no such pass, so that half is inserted explicitly.
        v m-vector XORs, no multiplications. */
+    PROBE_START_ID(PROBE_MCM_VKT_LAMBDA);
     m_vkt_add_lambda(VKtmp, lambda, PARAM_v(p));
+    PROBE_END_ID(PROBE_MCM_VKT_LAMBDA);
 
+    PROBE_START_ID(PROBE_MCM_VT_PV);
     Vt_times_Pv(VKtmp, V_multabs, VPV);
+    PROBE_END_ID(PROBE_MCM_VT_PV);
 
     if (use_l) {
         // L is materialized in the expanded key: Mtmp = V * L directly.
@@ -315,13 +325,23 @@ static inline void m_calculate_M_and_VPV(const mayo_params_t *p,
     } else {
         // implicit L: Mtmp = V * ((P1 + P1^t) * O + P2), reusing P1 * V^t.
         // VKtmp = (P1 + P1^t) * V^t; the diagonal cancels in characteristic two.
+        PROBE_START_ID(PROBE_MCM_O_MULTABS);
         mayo_O_multabs(O, O_multabs);
+        PROBE_END_ID(PROBE_MCM_O_MULTABS);
+        PROBE_START_ID(PROBE_MCM_P1T_VT);
         MAYO_CALL_P1T_VT(P1, V_multabs, VKtmp);
+        PROBE_END_ID(PROBE_MCM_P1T_VT);
+        PROBE_START_ID(PROBE_MCM_UT_O);
         Ut_times_O(VKtmp, O_multabs, Mtmp);
+        PROBE_END_ID(PROBE_MCM_UT_O);
+        PROBE_START_ID(PROBE_MCM_VT_L);
         Vt_times_L(P2_or_L, V_multabs, Mtmp);
+        PROBE_END_ID(PROBE_MCM_VT_L);
     }
 
+    PROBE_START_ID(PROBE_MCM_LAMBDA_OIL);
     m_lambda_oil(p, lambda, Mtmp);
+    PROBE_END_ID(PROBE_MCM_LAMBDA_OIL);
 
     mayo_secure_clear(VKtmp, sizeof(VKtmp));
     mayo_secure_clear(O_multabs, sizeof(O_multabs));
diff --git a/src/mayo.c b/src/mayo.c
index 4fbc10b..cc82793 100644
--- a/src/mayo.c
+++ b/src/mayo.c
@@ -13,6 +13,7 @@
 #ifdef ENABLE_CT_TESTING
 #include <valgrind/memcheck.h>
 #endif
+#include <profiling_probes.h>
 
 #define MAYO_MIN(x, y) (((x) < (y)) ? (x) : (y))
 #define PK_PRF AES_128_CTR
@@ -155,6 +156,7 @@ static void compute_A(const mayo_params_t *p, uint64_t *VtL, unsigned char *A_ou
         }
     }
 
+    PROBE_START_ID(PROBE_CA_ACC);
     /* the whipping schedule puts the pair of label l at row offset l, i.e. a shift
        of l nibbles: l/16 whole limb-rows plus 4*(l%16) bits within a limb */
     const unsigned char *whip_positions = PARAM_whip_pos(p);
@@ -174,10 +176,14 @@ static void compute_A(const mayo_params_t *p, uint64_t *VtL, unsigned char *A_ou
         }
     }
 
+    PROBE_END_ID(PROBE_CA_ACC);
+    PROBE_START_ID(PROBE_CA_TRANSPOSE);
     for (size_t c = 0; c < A_width*((PARAM_m(p) + (PARAM_k(p)+1)*PARAM_k(p)/2 +15)/16) ; c+= 16)
     {
         transpose_16x16_nibbles(A + c);
     }
+    PROBE_END_ID(PROBE_CA_TRANSPOSE);
+    PROBE_START_ID(PROBE_CA_FTAIL);
 
     /* the tail rows reduce into the rows below them, one GF(16) multiply per tap. A's
        rows sit sixteen to a block, so copy the sources out and the destinations back and
@@ -212,6 +218,7 @@ static void compute_A(const mayo_params_t *p, uint64_t *VtL, unsigned char *A_ou
             A[(i / 16) * A_width + c + (i % 16)] ^= ft_dst[i];
         }
     }
+    PROBE_END_ID(PROBE_CA_FTAIL);
     mayo_secure_clear(ft_src, sizeof(ft_src));
     mayo_secure_clear(ft_dst, sizeof(ft_dst));
     #undef FTAIL_ROWS
@@ -222,6 +229,7 @@ static void compute_A(const mayo_params_t *p, uint64_t *VtL, unsigned char *A_ou
 #endif
 
 
+    PROBE_START_ID(PROBE_CA_DECODE);
     /* A is blocked sixteen rows to a chunk; walk the rows and pick the chunk */
     for (int row = 0; row < PARAM_m(p); row++)
     {
@@ -231,6 +239,7 @@ static void compute_A(const mayo_params_t *p, uint64_t *VtL, unsigned char *A_ou
             decode( (unsigned char *) &A[base + c], A_out + PARAM_A_cols(p)*row + c, MAYO_MIN(16, PARAM_A_cols(p)-1-c));
         }
     }
+    PROBE_END_ID(PROBE_CA_DECODE);
 }
 
 static void unpack_m_vecs(const unsigned char *in, uint64_t *out, int vecs, int m){
@@ -313,11 +322,14 @@ static void expand_P1_P2(const mayo_params_t *p, uint64_t *P, const unsigned cha
     #ifndef ENABLE_PARAMS_DYNAMIC
     (void) p;
     #endif
+    PROBE_START_ID(PROBE_ESK_PK_PRF);
     PK_PRF((unsigned char *)P, PARAM_P1_bytes(p) + PARAM_P2_bytes(p), seed_pk, PARAM_pk_seed_bytes(p));
+    PROBE_END_ID(PROBE_ESK_PK_PRF);
     // m % 16 == 0: packed stride == padded stride, the keystream already is the layout.
     if (PARAM_m(p) % 16 == 0) {
         return;
     }
+    PROBE_START_ID(PROBE_ESK_UNPACK_MVECS);
 #ifdef MAYO_PACKED_P1P2
     if (!keep_p2_packed) { // P1 stays packed; spread only P2 into its padded slot
         unpack_m_vecs((unsigned char *)P + PARAM_P1_bytes(p), P + PARAM_P1_limbs(p),
@@ -327,6 +339,7 @@ static void expand_P1_P2(const mayo_params_t *p, uint64_t *P, const unsigned cha
     (void) keep_p2_packed;
     unpack_m_vecs((unsigned char *)P, P, (PARAM_P1_limbs(p) + PARAM_P2_limbs(p)) / PARAM_m_vec_limbs(p), PARAM_m(p));
 #endif
+    PROBE_END_ID(PROBE_ESK_UNPACK_MVECS);
 }
 
 static void eval_public_map(const mayo_params_t *p, const unsigned char *s, const uint64_t *P1, const uint64_t *P2, const uint64_t *P3, const uint64_t *lambda, unsigned char *eval){
@@ -365,9 +378,14 @@ static int expand_sk_internal(const mayo_params_t *p, const unsigned char *csk,
     const unsigned char *seed_sk = csk;
     unsigned char *seed_pk = S;
 
+    PROBE_START_ID(PROBE_ESK_SHAKE_SEED_O);
     shake256(S, param_pk_seed_bytes + param_O_bytes, seed_sk,
              param_sk_seed_bytes);
+    PROBE_END_ID(PROBE_ESK_SHAKE_SEED_O);
+
+    PROBE_START_ID(PROBE_ESK_DECODE_O);
     decode(S + param_pk_seed_bytes, O, param_v * param_o);
+    PROBE_END_ID(PROBE_ESK_DECODE_O);
 
     // keep the seed in the expanded key so Sign(esk) can derive the salt
     memcpy(sk->sk_seed, seed_sk, param_sk_seed_bytes);
@@ -376,7 +394,9 @@ static int expand_sk_internal(const mayo_params_t *p, const unsigned char *csk,
     VALGRIND_MAKE_MEM_DEFINED(seed_pk, param_pk_seed_bytes);
 #endif
 
+    PROBE_START_ID(PROBE_ESK_EXPAND_P1P2);
     expand_P1_P2(p, P, seed_pk, 0);
+    PROBE_END_ID(PROBE_ESK_EXPAND_P1P2);
     MAYO_ZERO_SLACK(P, PARAM_P1_limbs(p) + PARAM_P2_limbs(p));
 #ifdef TARGET_BIG_ENDIAN
     for (int i = 0; i < PARAM_P1_limbs(p) + PARAM_P2_limbs(p); ++i) {
@@ -444,7 +464,9 @@ static int sign_signature_internal(const mayo_params_t *p, unsigned char *sig,
     seed_sk = sk->sk_seed;
 
     // hash message
+    PROBE_START_ID(PROBE_HASH_MSG);
     shake256(tmp, param_digest_bytes, m, mlen);
+    PROBE_END_ID(PROBE_HASH_MSG);
 
     // sk is read-only on little-endian; on big-endian the swaps below convert it in
     // place and the err: block converts it back, leaving the caller's key unchanged.
@@ -474,8 +496,10 @@ static int sign_signature_internal(const mayo_params_t *p, unsigned char *sig,
     // hashing to salt
     memcpy(tmp + param_digest_bytes + param_salt_bytes, seed_sk,
            param_sk_seed_bytes);
+    PROBE_START_ID(PROBE_SALT);
     shake256(salt, param_salt_bytes, tmp,
              param_digest_bytes + param_salt_bytes + param_sk_seed_bytes);
+    PROBE_END_ID(PROBE_SALT);
 
 #ifdef ENABLE_CT_TESTING
     VALGRIND_MAKE_MEM_DEFINED(salt, SALT_BYTES_MAX); // Salt is not secret
@@ -485,29 +509,44 @@ static int sign_signature_internal(const mayo_params_t *p, unsigned char *sig,
     memcpy(tmp + param_digest_bytes, salt, param_salt_bytes);
     ctrbyte = tmp + param_digest_bytes + param_salt_bytes + param_sk_seed_bytes;
 
+    PROBE_START_ID(PROBE_HASH_T);
     shake256(tenc, param_m_bytes + MAYO_LAMBDA_SEED_BYTES, tmp,
              param_digest_bytes + param_salt_bytes);
+    PROBE_END_ID(PROBE_HASH_T);
 
     decode(tenc, t, param_m); // may not be necessary
+    PROBE_START_ID(PROBE_DERIVE_LAMBDA);
     derive_lambda(p, tenc + param_m_bytes, lambda);
+    PROBE_END_ID(PROBE_DERIVE_LAMBDA);
 
     for (int ctr = 0; ctr <= 255; ++ctr) {
         *ctrbyte = (unsigned char)ctr;
 
+        PROBE_START_ID(PROBE_SHAKE_V);
         shake256(V, param_k * param_v_bytes + param_r_bytes, tmp,
                  param_digest_bytes + param_salt_bytes + param_sk_seed_bytes + 1);
+        PROBE_END_ID(PROBE_SHAKE_V);
 
+        PROBE_START_ID(PROBE_DECODE_V);
         // decode the v_i vectors
         for (int i = 0; i < param_k; ++i) {
             decode(V + i * param_v_bytes, Vdec + i * param_v, param_v);
         }
+        PROBE_END_ID(PROBE_DECODE_V);
 
         // compute M_i matrices and all v_i*P1*v_j, with lambda folded in
+        PROBE_START_ID(PROBE_M_CALC_M_VPV);
         m_calculate_M_and_VPV(p, P1, P2_or_L, sk->O, Vdec, lambda, use_l,
                               Mtmp, (uint64_t *) A);
+        PROBE_END_ID(PROBE_M_CALC_M_VPV);
 
+        PROBE_START_ID(PROBE_COMPUTE_RHS);
         compute_rhs(p, (uint64_t*) A, t, y);
+        PROBE_END_ID(PROBE_COMPUTE_RHS);
+
+        PROBE_START_ID(PROBE_COMPUTE_A);
         compute_A(p, Mtmp, A);
+        PROBE_END_ID(PROBE_COMPUTE_A);
 
         for (int i = 0; i < param_m; i++)
         {
@@ -518,7 +557,10 @@ static int sign_signature_internal(const mayo_params_t *p, unsigned char *sig,
                param_k *
                param_o);
 
-        if (sample_solution(p, A, y, r, x, param_k, param_o, param_m, param_A_cols)) {
+        PROBE_START_ID(PROBE_SAMPLE_SOLUTION);
+        int sample_ok = sample_solution(p, A, y, r, x, param_k, param_o, param_m, param_A_cols);
+        PROBE_END_ID(PROBE_SAMPLE_SOLUTION);
+        if (sample_ok) {
             sol_found = 1;
             break;
         } else {
@@ -531,8 +573,10 @@ static int sign_signature_internal(const mayo_params_t *p, unsigned char *sig,
         goto err;
     }
 
+    PROBE_START_ID(PROBE_COMPUTE_S);
     m_compute_s(p, sk->O, Vdec, x, s);
     encode(s, sig, param_n * param_k);
+    PROBE_END_ID(PROBE_COMPUTE_S);
 
     memcpy(sig + param_sig_bytes - param_salt_bytes, salt, param_salt_bytes);
     *siglen = param_sig_bytes;
@@ -573,7 +617,9 @@ int mayo_sign_signature(const mayo_params_t *p, unsigned char *sig,
               size_t mlen, const unsigned char *csk) {
     const int use_l = 0; // all backends expand without L and sign implicitly
     alignas(32) sk_t sk;
+    PROBE_START_ID(PROBE_EXPAND_SK);
     int ret = expand_sk_internal(p, csk, &sk, use_l);
+    PROBE_END_ID(PROBE_EXPAND_SK);
     if (ret == MAYO_OK) {
         ret = sign_signature_internal(p, sig, siglen, m, mlen, &sk, use_l);
     }
diff --git a/src/profiling_probes.c b/src/profiling_probes.c
new file mode 100644
index 0000000..4e1be0b
--- /dev/null
+++ b/src/profiling_probes.c
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// Definition unique (liaison externe) de l'etat des sondes de profilage
+// declarees dans profiling_probes.h. Ce fichier doit etre compile et lie
+// dans le MEME binaire que mayo.c (qui ecrit via PROBE_START/PROBE_END) et
+// que le binaire de profilage (qui lit via profiling_probes_dump), pour
+// que les deux partagent le meme etat.
+#ifdef MAYO_PROFILING_PROBES
+
+#include <profiling_probes.h>
+
+const char *probe_names[PROBE_N] = {
+    "hash_message(shake256)",
+    "hash_salt(shake256)",
+    "hash_t(shake256)",
+    "derive_lambda",
+    "shake_V(per-attempt)",
+    "decode_V(per-attempt)",
+    "m_calculate_M_and_VPV(per-attempt)",
+    "compute_rhs(per-attempt)",
+    "compute_A(per-attempt)",
+    "sample_solution(per-attempt)",
+    "m_compute_s+encode(final)",
+    "expand_sk_internal",
+    "  ss.copy_r+clear_col(per-attempt)",
+    "  ss.EF_mat_vec_mul(per-attempt)",
+    "  ss.insert_y-Ar(per-attempt)",
+    "  ss.EF(per-attempt)",
+    "  ss.rank_check(per-attempt)",
+    "  ss.EF_backsub(per-attempt)",
+    "  esk.shake_seed_O",
+    "  esk.decode_O",
+    "  esk.expand_P1_P2",
+    "  esk.PK_PRF(in expand_P1_P2)",
+    "  esk.unpack_m_vecs(in expand_P1_P2)",
+    "    ef.PROFILED_TOTAL(cf PROBE_SS_EF)",
+    "    ef.row_masks",
+    "    ef.pivot_search",
+    "    ef.pivot_normalize",
+    "    ef.eliminate_rows",
+    "    mcm.V_multabs",
+    "    mcm.P1_times_Vt",
+    "    mcm.vkt_add_lambda",
+    "    mcm.Vt_times_Pv",
+    "    mcm.O_multabs",
+    "    mcm.P1t_times_Vt",
+    "    mcm.Ut_times_O",
+    "    mcm.Vt_times_L",
+    "    mcm.lambda_oil",
+    "    cA.acc(whip)",
+    "    cA.transpose",
+    "    cA.f_tail",
+    "    cA.decode",
+};
+
+uint64_t probe_cycles[PROBE_N];
+uint64_t probe_calls[PROBE_N];
+uint64_t probe_t0[PROBE_N];
+
+#endif // MAYO_PROFILING_PROBES
diff --git a/src/profiling_probes.h b/src/profiling_probes.h
new file mode 100644
index 0000000..6a269ad
--- /dev/null
+++ b/src/profiling_probes.h
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// Sondes de profilage temporaire pour decomposer mayo_sign_signature en
+// sous-etapes. Actif uniquement sous MAYO_PROFILING_PROBES (desactive par
+// defaut, aucun effet sur le build officiel). Accumule les cycles de
+// chaque etape sur toute l'execution du processus (thread-local naif,
+// suffisant pour un binaire de profilage mono-thread), et les imprime a
+// la fin via profiling_probes_dump().
+#ifndef MAYO_PROFILING_PROBES_H
+#define MAYO_PROFILING_PROBES_H
+
+#ifdef MAYO_PROFILING_PROBES
+
+#include <stdint.h>
+#include <stdio.h>
+#include <x86intrin.h>
+
+enum {
+    PROBE_HASH_MSG = 0,
+    PROBE_SALT,
+    PROBE_HASH_T,
+    PROBE_DERIVE_LAMBDA,
+    PROBE_SHAKE_V,
+    PROBE_DECODE_V,
+    PROBE_M_CALC_M_VPV,
+    PROBE_COMPUTE_RHS,
+    PROBE_COMPUTE_A,
+    PROBE_SAMPLE_SOLUTION,
+    PROBE_COMPUTE_S,
+    PROBE_EXPAND_SK,
+    // Decomposition fine de sample_solution (demande Dr Tale) :
+    PROBE_SS_COPY_R_CLEAR,   // x <- r, et clear derniere colonne de A
+    PROBE_SS_EF_MAT_VEC_MUL, // Ar = A * r
+    PROBE_SS_INSERT_Y_AR,    // derniere colonne de A <- y - Ar
+    PROBE_SS_EF,             // EF (elimination de Gauss)
+    PROBE_SS_RANK_CHECK,     // test de rang (derniere ligne de A)
+    PROBE_SS_EF_BACKSUB,     // EF_backsub (retro-substitution)
+    // Decomposition fine du chemin compact d'expand_sk_internal
+    // (materialize_l=0 uniquement — ne pas confondre avec P1P1t_times_O,
+    // qui appartient au chemin materialize_l=1, non emprunte par
+    // mayo_sign_signature) :
+    PROBE_ESK_SHAKE_SEED_O,  // shake256 -> seed_pk || O
+    PROBE_ESK_DECODE_O,      // decode(O)
+    PROBE_ESK_EXPAND_P1P2,   // expand_P1_P2 (englobe PK_PRF + unpack_m_vecs eventuel)
+    PROBE_ESK_PK_PRF,        // PK_PRF seul, a l'interieur de expand_P1_P2
+    PROBE_ESK_UNPACK_MVECS,  // unpack_m_vecs seul (uniquement si m%16 != 0, donc MAYO-3/5)
+    // Decomposition fine de EF (elimination de Gauss, chemin AVX2 pur,
+    // echelon_form_loop.h), demande Dr Tale. Mesuree sur une copie
+    // dediee EF_profiled (voir echelon_form_profiled.h), executee EN
+    // PLUS de l'appel normal a EF dans sample_solution (sur une copie
+    // de A), jamais a sa place : EF reste sur le chemin reellement
+    // mesure pour le tableau global, EF_profiled sert uniquement a
+    // cette decomposition et son propre cout total (PROBE_EF_PROFILED_TOTAL)
+    // est compare au cout de la vraie sonde PROBE_SS_EF pour quantifier
+    // l'overhead introduit par la granularite plus fine.
+    PROBE_EF_PROFILED_TOTAL,  // EF_profiled complete (pour comparaison a PROBE_SS_EF)
+    PROBE_EF_ROW_MASKS,       // ef_row_masks (masques eq/gt par ligne)
+    PROBE_EF_PIVOT_SEARCH,    // recherche/selection du pivot (lecture colonne + prefixe ct)
+    PROBE_EF_PIVOT_NORMALIZE, // inverse_f_ct + tbl32_gf16_multab + normalisation ligne pivot
+    PROBE_EF_ELIMINATE,       // boucle d'elimination des lignes (tables + shuffle + xor/blend)
+    // Sous-operations de m_calculate_M_and_VPV (chemin multab, implicit L)
+    PROBE_MCM_V_MULTABS,      // mayo_V_multabs (tables de V)
+    PROBE_MCM_P1_VT,          // P1_times_Vt
+    PROBE_MCM_VKT_LAMBDA,     // m_vkt_add_lambda
+    PROBE_MCM_VT_PV,          // Vt_times_Pv
+    PROBE_MCM_O_MULTABS,      // mayo_O_multabs
+    PROBE_MCM_P1T_VT,         // P1t_times_Vt
+    PROBE_MCM_UT_O,           // Ut_times_O
+    PROBE_MCM_VT_L,           // Vt_times_L
+    PROBE_MCM_LAMBDA_OIL,     // m_lambda_oil
+    // Sous-operations de compute_A
+    PROBE_CA_ACC,             // boucle m_compute_A_acc (whipping)
+    PROBE_CA_TRANSPOSE,       // transpose_16x16_nibbles
+    PROBE_CA_FTAIL,           // reduction f_tail
+    PROBE_CA_DECODE,          // decode final de A
+    PROBE_N
+};
+
+// IMPORTANT : ces trois tableaux doivent avoir une liaison EXTERNE et une
+// definition UNIQUE (dans profiling_probes.c), et non "static" ici. Ce
+// header est inclus a la fois par mayo.c (qui appelle PROBE_START/
+// PROBE_END, compile dans la bibliotheque ${MVARIANT}_profiling) et par
+// profile_probes.c (qui appelle profiling_probes_reset/dump), deux
+// traducteurs distincts qui doivent partager le MEME etat pour que les
+// sondes ecrites dans mayo.c soient lisibles depuis profile_probes.c. Avec
+// "static", chaque .c aurait sa propre copie privee et profile_probes.c
+// ne verrait jamais que des zeros (bug observe et corrige).
+extern const char *probe_names[PROBE_N];
+extern uint64_t probe_cycles[PROBE_N];
+extern uint64_t probe_calls[PROBE_N];
+// Un depart PAR identifiant de sonde (et non une variable unique partagee) :
+// certaines sondes sont imbriquees (ex. PROBE_EXPAND_SK, posee dans
+// mayo_sign_signature autour de expand_sk_internal, englobe
+// PROBE_ESK_SHAKE_SEED_O / PROBE_ESK_DECODE_O / PROBE_ESK_EXPAND_P1P2,
+// posees a l'interieur de expand_sk_internal ; PROBE_ESK_EXPAND_P1P2
+// englobe a son tour PROBE_ESK_PK_PRF / PROBE_ESK_UNPACK_MVECS, posees a
+// l'interieur de expand_P1_P2). Avec un probe_t0 unique partage entre
+// toutes les sondes, un PROBE_START() imbrique ecrase le depart de la
+// sonde englobante avant son PROBE_END(), ce qui a produit des valeurs
+// incoherentes (esk.PK_PRF mesure superieure a esk.expand_P1_P2 sur
+// MAYO-3/5) — bug observe et corrige. Avec un depart par id, les sondes
+// imbriquees restent correctes, mais leurs valeurs se RECOUVRENT
+// volontairement (PROBE_EXPAND_SK inclut le temps deja compte dans les
+// PROBE_ESK_*, PROBE_ESK_EXPAND_P1P2 inclut celui de PROBE_ESK_PK_PRF et
+// PROBE_ESK_UNPACK_MVECS) : ne jamais sommer des sondes d'un niveau
+// d'imbrication different dans le meme total.
+extern uint64_t probe_t0[PROBE_N];
+
+static inline uint64_t probe_rdtscp(void) {
+    unsigned int aux;
+    _mm_lfence();
+    return __rdtscp(&aux);
+}
+
+#define PROBE_START_ID(id) (probe_t0[(id)] = probe_rdtscp())
+#define PROBE_END_ID(id) do { \
+        _mm_lfence(); \
+        probe_cycles[(id)] += probe_rdtscp() - probe_t0[(id)]; \
+        probe_calls[(id)] += 1; \
+    } while (0)
+// Alias historiques : la forme a un seul argument n'est plus utilisable des
+// deux cotes avec un etat partage (voir ci-dessus). PROBE_START() seul ne
+// peut plus determiner quel probe_t0[id] remplir, donc ces deux macros sont
+// desormais des erreurs de compilation volontaires si on les appelle sans
+// id, pour forcer la mise a jour de tous les sites d'appel.
+#define PROBE_START() PROBE_START_REQUIRES_AN_ID_NOW
+#define PROBE_END(id) PROBE_END_REQUIRES_PROBE_END_ID_NOW
+
+static inline void profiling_probes_reset(void) {
+    for (int i = 0; i < PROBE_N; i++) { probe_cycles[i] = 0; probe_calls[i] = 0; }
+}
+
+static inline void profiling_probes_dump(const char *label, uint64_t total_cycles) {
+    printf("--- PROBES %s (total cumule mayo_sign_signature = %llu cycles) ---\n",
+           label, (unsigned long long) total_cycles);
+    uint64_t sum = 0;
+    for (int i = 0; i < PROBE_N; i++) {
+        sum += probe_cycles[i];
+        double pct = total_cycles ? (100.0 * (double) probe_cycles[i] / (double) total_cycles) : 0.0;
+        double avg_per_call = probe_calls[i] ? (double) probe_cycles[i] / (double) probe_calls[i] : 0.0;
+        printf("  %-38s cycles=%12llu calls=%8llu  avg/appel=%9.1f  %6.2f%%\n",
+               probe_names[i], (unsigned long long) probe_cycles[i],
+               (unsigned long long) probe_calls[i], avg_per_call, pct);
+    }
+    double pct_sum = total_cycles ? (100.0 * (double) sum / (double) total_cycles) : 0.0;
+    double pct_rest = 100.0 - pct_sum;
+    printf("  %-38s %25s  %6.2f%%\n", "[somme instrumentee]", "", pct_sum);
+    printf("  %-38s %25s  %6.2f%%\n", "[reste non instrumente]", "", pct_rest);
+}
+
+#else
+
+#define PROBE_START() ((void) 0)
+#define PROBE_END(id) ((void) 0)
+#define PROBE_START_ID(id) ((void) 0)
+#define PROBE_END_ID(id) ((void) 0)
+
+#endif // MAYO_PROFILING_PROBES
+
+#endif // MAYO_PROFILING_PROBES_H
