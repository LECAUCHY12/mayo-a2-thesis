+            target_compile_definitions(${MVARIANT_LOWER}_tailxmm PUBLIC MAYO_TAIL_XMM_SAFE)
+            target_compile_definitions(${MVARIANT_LOWER}_tailab PUBLIC MAYO_TAIL_XMM_SAFE)
